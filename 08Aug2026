    function computeMonthlyActuals() {
        let monthly = [...baseMonthlyActual];
        let monthlyTotals = {};
        let augDaysCount = 0;

        Object.keys(dailyRecords).forEach(dateStr => {
            const dateObj = new Date(dateStr);
            const monthIdx = dateObj.getMonth();
            const val = parseFloat(dailyRecords[dateStr]) || 0;

            if (!monthlyTotals[monthIdx]) monthlyTotals[monthIdx] = 0;
            monthlyTotals[monthIdx] += val;

            if (monthIdx === 7) augDaysCount++;
        });

        Object.keys(monthlyTotals).forEach(mIdx => {
            monthly[mIdx] = monthlyTotals[mIdx];
        });

        return { monthly, augDaysCount };
    }

    function calculateCumulative(arr) {
        let cum = [];
        let currentSum = 0;
        for (let i = 0; i < arr.length; i++) {
            if (arr[i] !== null) {
                currentSum += arr[i];
                cum.push(currentSum);
            } else {
                cum.push(null);
            }
        }
        return cum;
    }

